problem 38 - finding prime number
solution - 
#include<iostream>
using namespace std;
int main()
{
	int n;
	cout << "entre value of n";
	cin >> n;
	
	for (int i = 2 ;i <n;i++)
	{
		if (n % i != 0)
		{
			cout << " this number is Prime !!" << endl;
			break;
		}
		else
		{
			cout << " this number is not Prime !!" << endl;
			break;
		}
		
	
	}
}

