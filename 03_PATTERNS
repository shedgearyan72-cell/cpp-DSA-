problem 43 - printing rectangle using row and colns as input 
solution - 
#include<iostream>
using namespace std;
int main()
{
	int m;
	int n;
	cout << " Enter number of rows  : ";
	cin >> m;
	cout << " enter number of columns : ";
	cin >> n;
	for (int i = 1;i <= m;i++)
	{
		for (int i = 1;i <= n;i++)
		{
			cout << "*";
		}
		cout << endl;
	}
}

