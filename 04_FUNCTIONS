problem 62 - swapping two numbers without using 3rd variable 
solution - 
#include<iostream>
using namespace std;
int main()
{
	int x;
	int y;
	x = 2;
	y = 5;
	cout << x << " " << y << endl;
	x = x + y;
	y = x - y;
	x = x - y;
	cout << x << " " << y << endl;
	return 0;
}
