{
    int n;
    cout << "Enter value of n : ";
    cin >> n;
    int r;
    cout << "Enter value of n : ";
    cin >> r;
    int a;
    a = 1;
    int b;
    b = 1;
    for (int i = 1;i <= n;i++)
    {
        a *= i;
    }
   
    for (int i = 1;i <= r;i++)
    {
        b *= i;
    }
  
