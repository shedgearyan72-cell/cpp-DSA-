problem 58 - calculating combination using functions 
solution - 
#include<iostream>
#include<cmath>
using namespace std;
int fact(int x)
{
    int f = 1;
    for (int i = 1;i <= x;i++)
    {
        f *= i;
    }
    return f;

}
int main()
{
    int n;
    cout << "Enter value of n : ";
    cin >> n;
    int r;
    cout << "Enter value of n : ";
    cin >> r;
    int a = fact(n);
    int b= fact(r);
    int c = fact(n - r);
    
    cout << a/(b*c);
    return 0;
}

