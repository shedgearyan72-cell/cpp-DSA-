problem 64 - find maximum in array 
solution - 
#include<iostream>
using namespace std;
int main()
{
	int arr[] = { 10,25,7,42,18,30 };
	int n = sizeof(arr) / 4;
	int mx=0;
	for (int i = 0;i < n;i++)
	{
		mx = max(arr[i], mx);
	}
	cout << mx;
	return 0;
}

