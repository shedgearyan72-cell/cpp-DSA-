problem 28 - printing even no. from 1-100
solution - 
#include<iostream>
using namespace std;
int main()
{
	for (int i=1;i<=100;i++)
	{
		if (i % 2 == 0)
			cout << i << " ";
	}
}
----------------------------------------------------------
problem 29 - printing  odd no. from 1-100
solution - 
#include<iostream>
using namespace std;
int main()
{
	for (int i=1;i<=100;i++)
	{
		if (i % 2 != 0)
			cout << i << " ";
	}
}
