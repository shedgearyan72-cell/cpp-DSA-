problem 26 - printing hello world n times  
solution - 
#include<iostream>
using namespace std;
int main()
{
	
	int n;
	cout << "entre value of n : ";
	cin >> n;
	
	for (int i=1;i<n;i++)
	{
		cout << "hello world " << endl;
	}
	
}
