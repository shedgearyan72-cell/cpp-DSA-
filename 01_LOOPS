problem 31 - printing table of n 
solution 
#include<iostream>
using namespace std;
int main()
{
	int n;
	cout << " Entre value of n";
	cin >> n;
	for (int i=n;i<=n*10;i=i+n)
	{
			cout << i << " ";
	}
